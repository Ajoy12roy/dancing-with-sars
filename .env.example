# Google Gemini API key for AI insight generation (optional; deterministic offline fallback used if omitted)
GEMINI_API_KEY=

# Alternative Google API key for AI insight generation (optional fallback if GEMINI_API_KEY is not set)
GOOGLE_API_KEY=

# Public application URL used for OpenGraph and metadata resolution (optional; defaults to Vercel production URL or localhost)
NEXT_PUBLIC_APP_URL=

# Public endpoint for the external Python processing service (optional; precomputed case studies work offline without it)
NEXT_PUBLIC_PROCESSING_API_URL=

# Flag to enable local GeoTIFF upload processing route (optional; disabled by default on cloud hosting)
UPLOAD_ENABLED=

# Custom path to Python executable for local CLI processing (optional; auto-detected if omitted)
PYTHON_BIN=

# NASA Earthdata bearer token for downloading or streaming NISAR L-band granules (optional; only needed for NASA Earthdata Cloud data fetch)
EARTHDATA_TOKEN=
